# Configuration de l'application SEEG Intervention
# Copiez ce fichier vers .env et modifiez les valeurs

# ===================
# Paramètres Django
# ===================
DEBUG=False
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-a-changer-en-production
ALLOWED_HOSTS=api.seeg.ga,localhost,127.0.0.1

# ===================
# Base de données PostgreSQL
# ===================
DATABASE_URL=postgres://obrice:azerty@localhost:5432/seeg
DB_NAME=seeg
DB_USER=obrice
DB_PASSWORD=azerty
DB_HOST=localhost
DB_PORT=5432

# ===================
# Redis (Cache & WebSocket)
# ===================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# ===================
# Email (SMTP)
# ===================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app
DEFAULT_FROM_EMAIL=noreply@seeg.ga

# ===================
# SMS (OTP)
# ===================
# Pour production, configurez un service SMS (Twilio, Africa's Talking, etc.)
SMS_PROVIDER=console  # console, twilio, africastalking
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===================
# Sécurité
# ===================
CORS_ALLOWED_ORIGINS=https://app.seeg.ga,https://admin.seeg.ga
CSRF_TRUSTED_ORIGINS=https://api.seeg.ga

# ===================
# Fichiers statiques (DocumentRoot Apache /var/www/html/seeg)
# ===================
STATIC_ROOT=/var/www/html/seeg/static
MEDIA_ROOT=/var/www/html/seeg/media
